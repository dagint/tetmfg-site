---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — T.E.T. Mfg. Co., Inc."
  description="The page you requested could not be found."
>
  <section class="industrial-hero">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 text-center">
      <h1 class="text-3xl font-bold uppercase tracking-tight sm:text-4xl">Page not found</h1>
      <p class="mt-4 font-medium text-industrial-light/90">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="industrial-btn">Home</a>
        <a href="/contact/" class="industrial-btn border-industrial-light/50 bg-transparent text-industrial-light hover:bg-industrial-light/10 hover:border-industrial-light">
          Contact us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
