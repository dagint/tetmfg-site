---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/icons/Icon.astro';
---

<BaseLayout
  title="Facilities — T.E.T. Mfg. Co., Inc."
  description={'Full facilities listing: CNC milling, turning, Bullard Cutmaster VTL, surface grinding, lathes, Bridgeports, cut-off, inspection (Zeiss CMM), design. Middlefield, CT.'}
  current="/facilities/"
>
  <section class="industrial-hero">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-sm border border-industrial-steel/40 bg-industrial-steel/20 text-industrial-light/90" aria-hidden="true">
        <Icon name="facility" class="w-7 h-7" />
      </span>
      <h1 class="text-3xl font-bold uppercase tracking-tight sm:text-4xl">Facilities Listing</h1>
      <p class="mt-4 max-w-2xl font-medium text-industrial-light/90">
        Located in a modern 10,000 square foot facility in Middlefield, Connecticut, T.E.T. Manufacturing has the space to tackle your demanding requirements.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
      <span class="icon-wrap" aria-hidden="true"><Icon name="mill" class="w-6 h-6" /></span>
      CNC Milling
    </h2>
    <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
      <li>2010 MORI SEIKI NMV 5000 5-Axis, 5 Pallet Vertical</li>
      <li>2009 OKUMA HOWA 761V 30″ × 60″ table, 5-axis capability, spindle probe, and HP coolant</li>
      <li>2008 MORI SEIKI DV5100 20″ × 40″ table, 5-axis capability, spindle probe, and HP coolant</li>
      <li>2007 OKUMA HOWA 852V 33″ × 80″ table, 4th axis, spindle probe, and HP coolant</li>
      <li>2001 OKUMA &amp; HOWA 630H Twin pallet, full 4th, 39″ × 33″ × 36″ with HP coolant</li>
      <li>2001 KIWA KNH 400 6 pallet HMC 23″ × 23″ × 20″ 5-axis, and HP coolant</li>
      <li>2000 OKUMA &amp; HOWA 415 VMC two pallet, 10000 rpm spindle, 4th axis with HP coolant</li>
      <li>1999 MORI SEIKI SH500 Three pallet, 12000 rpm spindle, with HP coolant</li>
      <li>1997 MORI SEIKI MH63 Twin pallet, full 4th, 39″ × 33″ × 36″ with HP coolant</li>
      <li>1986 ENSHU VMC330, 6000 rpm spindle, 17″ × 30″ table</li>
    </ul>
  </section>

  <section class="industrial-section-alt">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
        <span class="icon-wrap" aria-hidden="true"><Icon name="gear" class="w-6 h-6" /></span>
        CNC Turning
      </h2>
      <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
        <li>2014 MORI SEIKI NLX2500SY/700 10″ chuck, Y-axis, sub spindle, live tooling and HP coolant</li>
        <li>2013 MORI SEIKI NLX2500SY/700 10″ chuck, Y-axis, sub spindle, bar feed, live tooling and HP coolant</li>
        <li>2013 MORI SEIKI NLX2500Y 10″ chuck, Y-axis, live tooling and HP coolant</li>
        <li>2011 OKUMA HOWA LB3000EX 10″ chuck, Y-axis, sub spindle, live tooling and HP coolant</li>
        <li>2007 MORI SEIKI NL-3000Y1250 12″ chuck, Y-axis, 49″ travel, live tooling and HP coolant</li>
        <li>2002 MORI SEIKI SL-303BMC 700 12″ chucker, live tooling and HP coolant</li>
        <li>1999 MORI SEIKI SL65A with 18″ buck &amp; 24″ Kitagawa chuck. 35″ turning capacity.</li>
        <li>1997 MORI SEIKI SL250BMC 8″ chucker with bar feed &amp; live tooling</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
      <span class="icon-wrap" aria-hidden="true"><Icon name="wrench" class="w-6 h-6" /></span>
      Surface Grinding
    </h2>
    <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
      <li>1983 HARIG, 6″ × 18″ with hydraulics</li>
    </ul>
  </section>

  <section class="industrial-section-alt">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
        <span class="icon-wrap" aria-hidden="true"><Icon name="gear" class="w-6 h-6" /></span>
        Lathes — Engine
      </h2>
      <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
        <li>2013 Vantage turret lathe 50″ capacity, 9″ bore, 148″ center distance, digital readout, tracing capabilities</li>
        <li>1998 HWACHEON 20″ swing, 60″ between centers, digital readout &amp; gap</li>
        <li>1984 HES 20″ swing, 64″ between centers</li>
        <li>1960 54″ Bullard Cutmaster VTL with angle attachment</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
      <span class="icon-wrap" aria-hidden="true"><Icon name="mill" class="w-6 h-6" /></span>
      Bridgeports
    </h2>
    <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
      <li>1990 — Series 2 Special with programmable readout</li>
      <li>1975–1986 Standard Series 1 well tooled with readouts</li>
    </ul>
  </section>

  <section class="industrial-section-alt">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
        <span class="icon-wrap" aria-hidden="true"><Icon name="wrench" class="w-6 h-6" /></span>
        Cut-Off
      </h2>
      <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
        <li>1979 DOALL band saw</li>
        <li>1978 KYSOR JOHNSON automatic, 10″ round 12″ flat capacity</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
      <span class="icon-wrap" aria-hidden="true"><Icon name="caliper" class="w-6 h-6" /></span>
      Inspection
    </h2>
    <p class="mt-2 font-medium text-industrial-dark/90">Complete inspection facility</p>
    <ul class="mt-4 list-none space-y-2 text-industrial-dark/90">
      <li>2002 ZEISS 28/40/20 C99/II coordinate measuring machine</li>
      <li>(2) Brown &amp; Sharpe Micro-Hites</li>
    </ul>
  </section>

  <section class="industrial-section-alt">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
        <span class="icon-wrap" aria-hidden="true"><Icon name="clipboard" class="w-6 h-6" /></span>
        Design and Engineering
      </h2>
      <p class="mt-4 text-industrial-dark/90">
        Small design facility with tool and fixture capabilities.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
      <span class="icon-wrap" aria-hidden="true"><Icon name="gear" class="w-6 h-6" /></span>
      Value-Added &amp; Subcontracting
    </h2>
    <p class="mt-4 max-w-3xl text-industrial-dark/80">
      We partner with a broad array of subcontractors for plating, grinding, painting, and other secondary operations. You get a single source for machined parts and finished components without managing multiple vendors.
    </p>
    <ul class="mt-4 list-inside list-disc space-y-2 text-industrial-dark/80">
      <li>Plating and surface treatment</li>
      <li>Grinding (surface and specialty)</li>
      <li>Painting and coating</li>
    </ul>
  </section>

  <section class="border-t-2 border-industrial-steel/50 bg-industrial-dark text-industrial-light">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 text-center">
      <p class="text-lg font-medium">Upcoming project? Get a quote.</p>
      <a href="/contact/" class="industrial-btn mt-4 focus:ring-offset-industrial-dark">
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
