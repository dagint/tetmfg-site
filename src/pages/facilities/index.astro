---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/icons/Icon.astro';

const facilities = await getCollection('facilities');
const sortedFacilities = facilities.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="CNC Equipment & Facilities — Mori Seiki, Okuma, Zeiss CMM | T.E.T. Mfg."
  description="Modern 10,000 sq ft manufacturing facility. CNC milling (5-axis Mori Seiki, Okuma), CNC turning (Y-axis, live tooling), Bullard VTL, Zeiss CMM inspection. Middlefield, Connecticut."
  current="/facilities/"
  pageType="facilities"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Facilities', url: '/facilities/' }
  ]}
>
  <section class="industrial-hero">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-sm border border-industrial-steel/40 bg-industrial-steel/20 text-industrial-light/90" aria-hidden="true">
        <Icon name="facility" class="w-7 h-7" />
      </span>
      <h1 class="text-3xl font-bold uppercase tracking-tight sm:text-4xl">Facilities Listing</h1>
      <p class="mt-4 max-w-2xl font-medium text-industrial-light/90">
        Located in a modern 10,000 square foot facility in Middlefield, Connecticut, T.E.T. Manufacturing has the space to tackle your demanding requirements.
      </p>
    </div>
  </section>

  <!-- Featured Equipment: New Mazak VTL -->
  <section class="industrial-section-alt">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="mb-6 flex items-center gap-3">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-sm bg-accent/10 text-accent" aria-hidden="true">
          <Icon name="gear" class="w-5 h-5" />
        </span>
        <h2 class="text-2xl font-bold uppercase tracking-tight text-industrial-dark">
          Featured Equipment
        </h2>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <h3 class="text-xl font-bold text-industrial-dark">
            Mazak MEGATURN 1600M VTL
          </h3>
          <p class="mt-3 text-lg font-semibold text-industrial-steel">
            60″ Diameter Turning Capacity
          </p>
          <p class="mt-4 text-industrial-dark/90">
            Our newest addition brings exceptional large diameter turning capabilities to T.E.T. Manufacturing. The Mazak MEGATURN 1600M vertical turning lathe handles workpieces up to 60″ in diameter, perfect for large components in aerospace, energy, and industrial applications.
          </p>
          <ul class="mt-6 space-y-2 text-industrial-dark/80">
            <li class="flex items-start">
              <span class="mr-2 text-accent">▸</span>
              <span><strong>60″ diameter swing</strong> for large components</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent">▸</span>
              <span><strong>High-pressure coolant</strong> for optimal chip evacuation</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent">▸</span>
              <span><strong>Advanced controls</strong> for precision and repeatability</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent">▸</span>
              <span><strong>Year 2025</strong> — latest technology</span>
            </li>
          </ul>
          <div class="mt-6">
            <a href="/contact/" class="inline-block rounded-sm border-2 border-industrial-steel bg-industrial-steel px-6 py-3 text-sm font-bold uppercase tracking-wide text-white transition-all hover:bg-industrial-dark focus:outline-none focus:ring-2 focus:ring-industrial-steel focus:ring-offset-2">
              Request a Quote
            </a>
          </div>
        </div>

        <div class="order-first lg:order-last">
          <div class="overflow-hidden rounded-sm border-2 border-industrial-steel/30 bg-white shadow-lg">
            <img
              src="/images/equipment/mazak-megaturn-1600.jpg"
              alt="Mazak MEGATURN 1600M VTL - 60 inch diameter vertical turning lathe"
              class="h-full w-full object-cover"
              loading="eager"
              width="800"
              height="600"
            />
          </div>
          <p class="mt-2 text-center text-sm text-industrial-dark/60">
            Mazak MEGATURN 1600M — Large Diameter Vertical Turning
          </p>
        </div>
      </div>
    </div>
  </section>

  {sortedFacilities.map((facility, index) => {
    const isAlternate = index % 2 === 1;
    const hasItems = facility.data.items.length > 0;
    const isValueAdded = facility.data.category === 'Value-Added & Subcontracting';

    return isAlternate ? (
      <section class="industrial-section-alt">
        <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
          <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
            <span class="icon-wrap" aria-hidden="true"><Icon name={facility.data.icon} class="w-6 h-6" /></span>
            {facility.data.category}
          </h2>
          {facility.data.description && (
            <p class="mt-4 text-industrial-dark/90">
              {facility.data.description}
            </p>
          )}
          {hasItems && (
            <ul class={`mt-4 space-y-2 text-industrial-dark/80 ${isValueAdded ? 'list-inside list-disc' : 'list-none text-industrial-dark/90'}`}>
              {facility.data.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ) : (
      <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <h2 class="section-heading-with-icon text-2xl font-bold uppercase tracking-tight text-industrial-dark">
          <span class="icon-wrap" aria-hidden="true"><Icon name={facility.data.icon} class="w-6 h-6" /></span>
          {facility.data.category}
        </h2>
        {facility.data.description && (
          <p class="mt-2 font-medium text-industrial-dark/90">{facility.data.description}</p>
        )}
        {hasItems && (
          <ul class={`mt-4 space-y-2 ${isValueAdded ? 'list-inside list-disc text-industrial-dark/80' : 'list-none text-industrial-dark/90'}`}>
            {facility.data.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    );
  })}

  <section class="border-t-2 border-industrial-steel/50 bg-industrial-dark text-industrial-light">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 text-center">
      <p class="text-lg font-medium">Upcoming project? Get a quote.</p>
      <a href="/contact/" class="industrial-btn mt-4 focus:ring-offset-industrial-dark">
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
