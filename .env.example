# Optional: for local dev. Do NOT commit real values.
# In production, set these as Cloudflare Pages Environment variables or Secrets
# so no phone/email is stored in the repository.

# Phone number shown on contact page (e.g. 860-349-1004)
# TET_PHONE=

# Email parts for obfuscated contact (user + @ + domain)
# TET_EMAIL_USER=info
# TET_EMAIL_DOMAIN=tetmfg.com

# Cloudflare Web Analytics (optional): get token from Cloudflare dashboard → Web Analytics
# CLOUDFLARE_ANALYTICS_TOKEN=

# Optional: site URL (used by sitemap; also set via astro.config.mjs site)
# SITE_URL=https://tetmfg.com
